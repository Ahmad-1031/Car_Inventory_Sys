extends layout
include car-card

block content
    include navbar.pug
    
    .container
        .row 
            each car in cars 
                .col-md-4 
                    +CarCard(
                        car.make,
                        car.model,
                        car.engine,
                        car.power,
                        car.year,
                        car.price,
                        car.mileage,
                        car.fuel,
                        car.transmission,
                        car.image
                    )
                
                
