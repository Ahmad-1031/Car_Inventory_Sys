extends layout

block content
  .container
    .row.justify-content-center.mt-5
      .col-12.col-md-8.col-lg-6
        .card.login-card.shadow-sm.rounded
          .card-body.p-4.p-md-5
            form(action='/login', method='POST')
              input(type='hidden' name='_csrf' value=csrfToken)
              fieldset
                h2.mb-4 Login

                if error 
                  .alert.alert-danger(role='alert')= error

                if success 
                  .alert.alert-success(role='alert')= success
                div
                  label.form-label(for='exampleInputEmail1') Email address
                  input#exampleInputEmail1.form-control(
                    type='email'
                    name='email'
                    aria-describedby='emailHelp'
                    placeholder='Enter email'
                    required
                  )
                  

                div
                  label.form-label.mt-4(for='exampleInputPassword1') Password
                  input#exampleInputPassword1.form-control(
                    type='password'
                    name='password'
                    placeholder='Password'
                    autocomplete='off'
                    required
                  )

                p.mt-3
                  | Not registered?
                  a.ms-1(href='/register') Create an account

                button.btn.btn-primary.mt-3(type='submit') Login