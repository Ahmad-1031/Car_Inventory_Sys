extends layout

block content
  .container
    .row.justify-content-center.mt-5
      .col-12.col-md-8.col-lg-6
        .card.login-card.shadow-sm.rounded
          .card-body.p-4.p-md-5
            form
              fieldset
                h2.mb-4 Login

                div
                  label.form-label(for='exampleInputEmail1') Email address
                  input#exampleInputEmail1.form-control(
                    type='email'
                    aria-describedby='emailHelp'
                    placeholder='Enter email'
                  )
                  

                div
                  label.form-label.mt-4(for='exampleInputPassword1') Password
                  input#exampleInputPassword1.form-control(
                    type='password'
                    placeholder='Password'
                    autocomplete='off'
                  )

                p.mt-3
                  | Not registered?
                  a(href='/register') Create an account

                button.btn.btn-primary.mt-3(type='submit') Submit