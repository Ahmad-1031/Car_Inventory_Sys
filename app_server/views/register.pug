extends layout

block content
  .container
    .row.justify-content-center.mt-5
      .col-12.col-md-8.col-lg-6
        .card.login-card.shadow-sm.rounded
          .card-body.p-4.p-md-5
            form
              fieldset
                h2.mb-4 Register
                div
                  label.form-label(for='FirstName') First Name
                  input#FirstName.form-control(type='text' placeholder='First Name')
                div
                  label.form-label.mt-4(for='Surname') Surname
                  input#Surname.form-control(type='text' placeholder='Surname')
                div
                  label.form-label.mt-4(for='exampleInputEmail1') Email address
                  input#exampleInputEmail1.form-control(type='email' placeholder='Enter email')
                div
                  label.form-label.mt-4(for='Organization') Organization
                  select#Organization.form-select(name='organization' required)
                    option(value='' selected disabled) Select an organization
                    option(value='org1') Organization 1
                    option(value='org2') Organization 2
                    option(value='org3') Organization 3
                div
                  label.form-label.mt-4(for='exampleInputPassword1') Password
                  input#exampleInputPassword1.form-control(type='password' placeholder='Password' autocomplete='off')
                div
                  label.form-label.mt-4(for='exampleInputPassword2') Re-enter Password
                  input#exampleInputPassword2.form-control(type='password' placeholder='Re-enter Password' autocomplete='off')
                button.btn.btn-primary.mt-3(type='submit') Submit